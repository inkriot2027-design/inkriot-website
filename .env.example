# ─────────────────────────────────────────────────────────────
# INKRIOT — Environment Variables (copy to .env.local to use)
# ─────────────────────────────────────────────────────────────

# Firebase (client) — safe to expose (public web config).
# Auth falls back to a local mock provider when these are empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Contact form — where submissions are forwarded (server-side).
# When empty, the API logs submissions and returns success (dev mode).
CONTACT_FORWARD_EMAIL=
CONTACT_WEBHOOK_URL=
